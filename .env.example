# LLM
OPENAI_API_KEY=

# Flights
TRAVELPAYOUTS_API_KEY=

# Hotels
BOOKING_RAPIDAPI_KEY=

# Maps & Geo
GOOGLE_MAPS_API_KEY=

# Weather
OPENWEATHERMAP_API_KEY=

# Attractions / Search
SERPER_API_KEY=
TAVILY_API_KEY=

# Cover photos (Week 14) — optional; falls back to a CSS gradient cover if unset
UNSPLASH_ACCESS_KEY=

# FastAPI backend (Week 15) — optional; leave blank to disable API-key checks locally
API_KEY=

# React frontend origins allowed to call the API (Week 16) — comma-separated
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Infra (added in later weeks)
REDIS_URL=redis://localhost:6379/0

# Session storage + LangGraph checkpointing (Week 18) — optional; leave
# blank for plain `make serve` (uses local SQLite files, zero setup).
# docker-compose.yml sets this itself to point at its own postgres
# service; only set it here if you're running a real Postgres locally
# without Docker.
DATABASE_URL=

# Observability (Week 19). LangSmith: set LANGCHAIN_TRACING_V2=true plus a
# real key to trace every agent run at smith.langchain.com - LangChain
# reads these three directly from the environment, no other setup needed.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=travel-agent

# Sentry error tracking - optional, blank disables it (same pattern as
# every other optional credential in this file).
SENTRY_DSN=

# Structured logging (structlog). "console" for local dev (human-readable,
# colorized); "json" for anywhere logs get aggregated (Docker/CI/a real
# deployment) - docker-compose.yml sets this to "json" itself.
LOG_LEVEL=INFO
LOG_FORMAT=console

# Real user accounts. JWT_SECRET has a clearly-marked, insecure dev default
# so local dev/tests work out of the box - a real deployment MUST set a
# real value, or every token it issues is forgeable by anyone who's read
# config.py. JWT_EXPIRE_MINUTES defaults to 7 days.
JWT_SECRET=
JWT_EXPIRE_MINUTES=

# Forgot-password. PASSWORD_RESET_EXPIRE_MINUTES defaults to 15. Where a
# reset-link/share-link email should point back to - the Vite dev server
# by default; docker-compose.yml overrides this to :8080 (the Dockerized
# frontend) itself.
PASSWORD_RESET_EXPIRE_MINUTES=
FRONTEND_BASE_URL=http://localhost:5173

# SMTP for real password-reset emails - optional; blank logs the reset
# link instead of sending it (same optional-credential pattern as every
# other integration in this file), which is enough to develop/demo the
# flow without a real mail provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@waypoint.local
